# APP
APP_PORT=

# DATABASE
DATABASE_URL=

# JWT access and refresh secrets. also expires times
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

JWT_ACCESS_EXPIRE_TIME=
JWT_REFRESH_EXPIRE_TIME=

# JOYTEL AUTH ENVIROMENTS
JOYTEL_URL=
JOYTEL_SECRET_ID=
JOYTEL_SECRET_KEY=

# BILLION CONNECT AUTH ENVIROMENTS
BILLION_CONNECT_URL=
BILLION_CONNECT_SECRET_ID=
BILLION_CONNECT_SECRET_KEY=

# PAYMENT ENVIROMENTS
TBANK_URL=
TBANK_TERMINAL_ID=
TBANK_PASSWORD=
TBANK_WEBHOOK_URL=
# true — отклонять webhook с неверной подписью.
# Пока не убедились на живом трафике, что подпись сходится, держим выключенным:
# несовпадения пишутся в лог как TBANK WEBHOOK SIGNATURE MISMATCH, заказ обрабатывается
TBANK_VERIFY_WEBHOOK=false


# DECORATOR ENVIROMENTS
ROLES_DECORATOR_KEY=

# BASIC AUTH для Swagger (/docs) и дашборда логов (/logs).
# Если не заданы — /docs не монтируется, /logs отдаёт 404.
DOCS_USER=
DOCS_PASS=
LOGS_USER=
LOGS_PASS=

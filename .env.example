# APP
APP_PORT=

# DATABASE
DATABASE_URL=

# JWT access and refresh secrets. also expires times
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

JWT_ACCESS_EXPIRE_TIME=
JWT_REFRESH_EXPIRE_TIME=

# JOYTEL AUTH ENVIROMENTS
JOYTEL_URL=
JOYTEL_SECRET_ID=
JOYTEL_SECRET_KEY=

# BILLION CONNECT AUTH ENVIROMENTS
BILLION_CONNECT_URL=
BILLION_CONNECT_SECRET_ID=
BILLION_CONNECT_SECRET_KEY=

# PAYMENT ENVIROMENTS
TBANK_URL=
TBANK_TERMINAL_ID=
TBANK_PASSWORD=
TBANK_WEBHOOK_URL=
# true — отклонять webhook с неверной подписью.
# Пока не убедились на живом трафике, что подпись сходится, держим выключенным:
# несовпадения пишутся в лог как TBANK WEBHOOK SIGNATURE MISMATCH, заказ обрабатывается
TBANK_VERIFY_WEBHOOK=false


# TELEGRAM — уведомления админу о заказах и ошибках партнёров.
# Узнать chat_id: написать боту @userinfobot (для группы — добавить его в
# группу, id группы будет отрицательным числом).
# Если не задан — используется старый захардкоженный чат (см. предупреждение в логах).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Личный чат: сюда уходит уведомление о каждой отправке заказа партнёру
# (JoyTel/BillionConnect) с сырым ответом. Не задан — такие уведомления просто
# не отправляются (не падают в общий чат). Финальное "eSIM активирована" с QR
# и ошибки активации по-прежнему идут в TELEGRAM_ADMIN_CHAT_ID.
TELEGRAM_PERSONAL_CHAT_ID=

# DECORATOR ENVIROMENTS
ROLES_DECORATOR_KEY=

# BASIC AUTH для Swagger (/docs) и дашборда логов (/logs).
# Если не заданы — /docs не монтируется, /logs отдаёт 404.
DOCS_USER=
DOCS_PASS=
LOGS_USER=
LOGS_PASS=

# MOBILINE (eSIM issuance; callback is registered with the provider)
# POST https://api.jetsim.ru/order/mobiline/callback
MOBILINE_BASE_URI=http://115.85.181.26:6080
MOBILINE_GROUP_ID=
MOBILINE_GROUP_KEY=

# SKYBLUE (Mobiline data usage)
SKYBLUE_BASE_URI=https://skyblue.glocalnet.jp
SKYBLUE_EMAIL=
SKYBLUE_PASSWORD=

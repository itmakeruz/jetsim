// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int     @id @default(autoincrement())
  name         String?
  email        String?
  password     String?
  is_verified  Boolean @default(false)
  // Служебный пользователь B2B-компании (держит её SIM/заказы, войти им нельзя)
  is_service   Boolean @default(false)
  fcm_token    String?
  phone_number String?
  address      String?
  about        String?
  image        String?

  transaction  Transaction[]
  basket       Basket[]
  orders       Order[]
  sims         Sims[]
  promo_usages PromoUsage[]
  reseller     Reseller?

  created_at DateTime  @default(now()) @db.Timestamptz(5)
  updated_at DateTime? @updatedAt @db.Timestamptz(5)

  @@index([email])
  @@index([phone_number])
  @@map("user")
}

model Staff {
  id       Int        @id @default(autoincrement())
  name     String
  login    String
  password String
  role     UserRoles?
  status   Status

  promo_codes           PromoCode[]          @relation("promo_code_agent")
  created_promo_codes   PromoCode[]          @relation("promo_code_creator")
  agent_balance_ledgers AgentBalanceLedger[]

  created_at DateTime  @default(now()) @db.Timestamptz(5)
  updated_at DateTime? @updatedAt @db.Timestamptz(5)

  @@map("staff")
}

model SupportOperators {
  id         Int       @id @default(autoincrement())
  name       String?
  login      String?
  password   String?
  status     Status?   @default(ACTIVE)
  created_at DateTime  @default(now()) @db.Timestamptz(5)
  updated_at DateTime? @updatedAt @db.Timestamptz(5)

  @@map("support_operator")
}

model Region {
  id          Int     @id @default(autoincrement())
  name_ru     String
  name_en     String
  image       String?
  cover_image String?
  status      Status

  sims          Sims[]
  tariffs       Tariff[]      @relation("tariff_regions")
  bascet_items  BasketItem[]  @relation("basketitem_to_region")
  region_groups RegionGroup[] @relation("region_to_regiongroup")

  created_at DateTime  @default(now()) @db.Timestamptz(5)
  updated_at DateTime? @updatedAt @db.Timestamptz(5)

  @@map("region")
}

model RegionGroup {
  id          Int     @id @default(autoincrement())
  name_ru     String?
  name_en     String?
  status      Status  @default(ACTIVE)
  image       String?
  cover_image String?

  tariffs Tariff[]
  regions Region[] @relation("region_to_regiongroup")

  created_at DateTime  @default(now()) @db.Timestamptz(5)
  updated_at DateTime? @updatedAt @db.Timestamptz(5)

  @@map("region_group")
}

model Transaction {
  id                     Int               @id @default(autoincrement())
  amount                 String
  status                 TransactionStatus @default(PENDING)
  partner_transaction_id BigInt?
  order_id               Int?
  user_id                Int?

  user  User?  @relation(fields: [user_id], references: [id])
  order Order? @relation(fields: [order_id], references: [id])

  request     Json?
  response    Json?
  promo_usage PromoUsage?

  created_at DateTime  @default(now()) @db.Timestamptz(5)
  updated_at DateTime? @updatedAt @db.Timestamptz(5)

  @@map("transaction")
}

model Tariff {
  id                Int     @id @default(autoincrement())
  name_ru           String
  name_en           String
  title_ru          String?
  title_en          String?
  status            Status
  partner_id        Int
  is_4g             Boolean @default(false)
  is_5g             Boolean @default(false)
  quantity_sms      Int?
  quantity_minute   Int?
  quantity_internet Int?
  validity_period   Int?
  price_arrival     Int?
  price_sell        Int?
  sku_id            String
  cashback_percent  Int?
  type              Int?
  is_global         Boolean @default(false)
  is_popular        Boolean @default(false)
  is_local          Boolean @default(false)
  is_regional       Boolean @default(false)
  region_group_id   Int?

  regions          Region[]         @relation("tariff_regions")
  region_group     RegionGroup?     @relation(fields: [region_group_id], references: [id])
  partner          Partner          @relation(fields: [partner_id], references: [id])
  bascet_item      BasketItem[]
  sims             Sims[]
  reseller_tariffs ResellerTariff[]
  reseller_orders  ResellerOrder[]

  created_at DateTime  @default(now()) @db.Timestamptz(5)
  updated_at DateTime? @updatedAt @db.Timestamptz(5)
  deleted_at DateTime? @db.Timestamptz(5)

  @@map("tariff")
}

model Sims {
  id                   Int         @id @default(autoincrement())
  status               OrderStatus
  partner_id           Int
  order_id             Int?
  user_id              Int
  tariff_id            Int
  order_tid            String?
  order_code           String?
  sn_code              String?
  sn_pin               String?
  sn_puk               String?
  product_expire_date  String?
  coupon               String?
  qrcode_type          Int?
  qrcode               String?
  cid                  String?
  sale_plan_name       String?
  sale_plan_days       String?
  pin_1                String?
  pin_2                String?
  puk_1                String?
  puk_2                String?
  outbound_code        String?
  customer_code        String?
  product_code         String?
  channel_order_id     String?
  partner_order_id     String?
  uid                  String?
  iccid                String?
  sub_order_id         String?
  channel_sub_order_id String?
  msisdn               String?
  apn                  String?
  main_region_id       Int?
  partner_sim_status   Int?
  sim_status           SimStatus?
  last_usage_quantity  String?
  usage_snapshot       Json?
  usage_checked_at     DateTime?   @db.Timestamptz(5)
  // Заполнено только у eSIM, выпущенных для партнёрской (B2B) компании
  reseller_order_id    Int?        @unique

  user           User           @relation(fields: [user_id], references: [id])
  partner        Partner        @relation(fields: [partner_id], references: [id])
  tariff         Tariff         @relation(fields: [tariff_id], references: [id])
  order          Order?         @relation(fields: [order_id], references: [id])
  main_region    Region?        @relation(fields: [main_region_id], references: [id])
  events         OrderEvent[]
  reseller_order ResellerOrder? @relation(fields: [reseller_order_id], references: [id])

  request  Json?
  response Json?

  created_at DateTime  @default(now()) @db.Timestamptz(5)
  updated_at DateTime? @updatedAt @db.Timestamptz(5)

  @@index([partner_id, channel_order_id])
  @@index([iccid])
  @@index([order_id])
  @@index([user_id])
  @@index([status])
  @@index([created_at])
  @@map("sims")
}

model Partner {
  id                Int     @id @default(autoincrement())
  name_ru           String
  name_en           String
  description_ru    String?
  description_en    String?
  image             String?
  status            Status
  identified_number Int?

  sims   Sims[]
  tariff Tariff[]

  created_at DateTime  @default(now()) @db.Timestamptz(5)
  updated_at DateTime? @updatedAt @db.Timestamptz(5)

  @@map("partner")
}

model Order {
  id                Int         @id @default(autoincrement())
  status            OrderStatus
  user_id           Int
  transaction_id    Int?
  // Заполнено только у «оболочки» заказа B2B-компании; розничные выборки её исключают
  reseller_order_id Int?        @unique

  user           User           @relation(fields: [user_id], references: [id])
  sims           Sims[]
  transactions   Transaction[]
  promo_usage    PromoUsage?
  events         OrderEvent[]
  reseller_order ResellerOrder? @relation(fields: [reseller_order_id], references: [id])

  created_at DateTime  @default(now()) @db.Timestamptz(5)
  updated_at DateTime? @updatedAt @db.Timestamptz(5)

  @@index([status])
  @@index([user_id])
  @@index([created_at])
  @@map("order")
}

model Basket {
  id         Int          @id @default(autoincrement())
  user_id    Int?
  session_id String?
  status     BasketStatus @default(ACTIVE)
  user       User?        @relation(fields: [user_id], references: [id])

  items BasketItem[]

  created_at DateTime @default(now()) @db.Timestamptz(5)
  updated_at DateTime @updatedAt @db.Timestamptz(5)

  @@map("basket")
}

model BasketItem {
  id        Int  @id @default(autoincrement())
  basket_id Int
  tariff_id Int?
  region_id Int?
  quantity  Int  @default(1)
  price     Int?

  basket Basket  @relation(fields: [basket_id], references: [id])
  tariff Tariff? @relation(fields: [tariff_id], references: [id])
  region Region? @relation("basketitem_to_region", fields: [region_id], references: [id])

  created_at DateTime @default(now()) @db.Timestamptz(5)
  updated_at DateTime @updatedAt @db.Timestamptz(5)

  @@map("basket_item")
}

model Faq {
  id          Int     @id @default(autoincrement())
  question_ru String?
  question_en String?
  answer_ru   String?
  answer_en   String?
  status      Status? @default(ACTIVE)

  created_at DateTime @default(now()) @db.Timestamptz(5)
  updated_at DateTime @updatedAt @db.Timestamptz(5)

  @@map("faqs")
}

model PromoSettings {
  id                             Int                    @id @default(1)
  default_client_discount_amount Int?
  default_agent_credit_amount    Int?
  is_agent_creation_enabled      Boolean?
  agent_creation_mode            PromoCodeCreationMode?
  allow_limit_once               Boolean?
  allow_limit_unlimited          Boolean?
  allow_limit_custom             Boolean?
  allow_no_expiry                Boolean?
  allow_expires_at               Boolean?

  created_at DateTime  @default(now()) @db.Timestamptz(5)
  updated_at DateTime? @updatedAt @db.Timestamptz(5)

  @@map("promo_settings")
}

model PromoCode {
  id                     Int                   @id @default(autoincrement())
  code                   String                @unique
  status                 Status                @default(ACTIVE)
  creation_mode          PromoCodeCreationMode
  usage_limit            Int?
  used_count             Int                   @default(0)
  expires_at             DateTime?             @db.Timestamptz(5)
  client_discount_amount Int
  agent_credit_amount    Int                   @default(0)
  agent_id               Int?
  created_by_staff_id    Int?

  agent            Staff?       @relation("promo_code_agent", fields: [agent_id], references: [id], onDelete: SetNull)
  created_by_staff Staff?       @relation("promo_code_creator", fields: [created_by_staff_id], references: [id], onDelete: SetNull)
  usages           PromoUsage[]

  created_at DateTime  @default(now()) @db.Timestamptz(5)
  updated_at DateTime? @updatedAt @db.Timestamptz(5)

  @@index([agent_id])
  @@index([status])
  @@map("promo_code")
}

model PromoUsage {
  id                  Int              @id @default(autoincrement())
  promo_code_id       Int
  user_id             Int
  transaction_id      Int?             @unique
  order_id            Int?             @unique
  status              PromoUsageStatus @default(PENDING)
  discount_amount     Int
  agent_credit_amount Int              @default(0)
  confirmed_at        DateTime?        @db.Timestamptz(5)
  canceled_at         DateTime?        @db.Timestamptz(5)

  promo_code  PromoCode           @relation(fields: [promo_code_id], references: [id])
  user        User                @relation(fields: [user_id], references: [id])
  transaction Transaction?        @relation(fields: [transaction_id], references: [id])
  order       Order?              @relation(fields: [order_id], references: [id])
  ledger      AgentBalanceLedger?

  created_at DateTime  @default(now()) @db.Timestamptz(5)
  updated_at DateTime? @updatedAt @db.Timestamptz(5)

  @@index([promo_code_id])
  @@index([user_id])
  @@map("promo_usage")
}

model AgentBalanceLedger {
  id             Int                      @id @default(autoincrement())
  agent_id       Int
  promo_usage_id Int                      @unique
  amount         Int
  type           AgentBalanceLedgerType   @default(CREDIT)
  status         AgentBalanceLedgerStatus @default(CONFIRMED)

  agent       Staff      @relation(fields: [agent_id], references: [id], onDelete: Cascade)
  promo_usage PromoUsage @relation(fields: [promo_usage_id], references: [id], onDelete: Cascade)

  created_at DateTime  @default(now()) @db.Timestamptz(5)
  updated_at DateTime? @updatedAt @db.Timestamptz(5)

  @@index([agent_id])
  @@map("agent_balance_ledger")
}

enum Status {
  ACTIVE
  INACTIVE
}

enum BasketStatus {
  PENDING
  ORDERED
  ACTIVATED
  FAILED
  ACTIVE
}

enum OrderStatus {
  CREATED
  REDEEM_COUPON
  NOTIFY_COUPON
  COMPLETED
  PENDING
  FAILED
  CANCELED // отменён сотрудником в админке
}

enum SimStatus {
  ACTIVATED
  EXPIRED
}

/**
 * Полная история заказа от создания до выдачи: создан, оплата запрошена,
 * вебхук от Т-Банка пришёл, заявка ушла партнёру (JoyTel/BillionConnect),
 * пришёл колбэк, запрошен QR — и что партнёр ответил на каждом шаге.
 * sim_id проставлен только у событий, которые относятся к конкретной eSIM
 * (партнёрские шаги); у событий уровня заказа (создание, оплата) его нет —
 * order_id обязателен всегда, это и есть ось таймлайна.
 */
model OrderEvent {
  id         Int      @id @default(autoincrement())
  order_id   Int
  sim_id     Int?
  partner_id Int?
  event      String
  severity   String   @default("info")
  message    String?
  meta       Json?
  created_at DateTime @default(now()) @db.Timestamptz(5)

  order Order @relation(fields: [order_id], references: [id])
  sim   Sims? @relation(fields: [sim_id], references: [id])

  @@index([order_id])
  @@index([sim_id])
  @@index([created_at])
  @@map("order_events")
}

enum OrderJobStatus {
  PENDING
  SUCCESS
  ERROR
}

enum UserRoles {
  SUPER_ADMIN
  ADMIN
  ACCOUNTANT
  PRE_ACCOUNTANT
  AGENT
}

enum PromoCodeCreationMode {
  AUTO
  MANUAL
  BOTH
}

enum PromoUsageStatus {
  PENDING
  CONFIRMED
  CANCELED
}

enum AgentBalanceLedgerType {
  CREDIT
}

enum AgentBalanceLedgerStatus {
  CONFIRMED
  CANCELED
}

enum TariffType {
  ECONOMY
  STANDARD
  TURBO
}

enum TransactionStatus {
  PENDING // Xarid yaratilgan, to'lov kutilmoqda
  SUCCESS // To'lov muvaffaqiyatli amalga oshdi
  WAITING_ORDER_CONFIRMATION // To'lov tasdiqlanishi kutilmoqda
  FAILED // To'lov rad etildi / muvaffaqiyatsiz
  CANCELED // To'lov bekor qilindi
  REFUNDED // To'lov qaytarildi
  ERROR // Tizim xatosi
  UNKNOWN // Status hali aniqlanmagan
}

// ======================= B2B: партнёрские компании (Reseller) =======================
// Reseller — компания партнёрской платформы. Не путать с Partner (поставщики eSIM).
// Деньги — целые минорные единицы валюты компании (копейки/центы, BigInt). Валюта компании: RUB или USD,
// задаётся при создании и не меняется; поля *_kopecks хранят минорные единицы любой из них.

enum ResellerStatus {
  ACTIVE
  BLOCKED
}

enum ResellerKeyStatus {
  ACTIVE
  REVOKED
}

enum ResellerLedgerType {
  TOPUP
  ADJUSTMENT
  RESERVE
  RELEASE
  CAPTURE
  REFUND
}

enum ResellerOrderState {
  RESERVED // деньги зарезервированы, поставщику ещё не отправляли
  SUBMITTING // заявка уходит поставщику (отмена уже невозможна)
  SUBMITTED // поставщик принял, ждём выдачу
  ISSUED // eSIM выдана, резерв списан
  FAILED // достоверный отказ, резерв освобождён
  RECONCILE // результат неизвестен, резерв удержан до сверки
  CANCELLED // отменён до отправки, резерв освобождён
  REFUNDED // возврат после выдачи подтверждён
}

model Reseller {
  id              Int            @id @default(autoincrement())
  name            String
  status          ResellerStatus @default(ACTIVE)
  currency        String         @default("RUB")
  service_user_id Int            @unique

  service_user User             @relation(fields: [service_user_id], references: [id])
  api_keys     ResellerApiKey[]
  tariffs      ResellerTariff[]
  account      ResellerAccount?
  ledger       ResellerLedger[]
  orders       ResellerOrder[]

  created_at DateTime  @default(now()) @db.Timestamptz(5)
  updated_at DateTime? @updatedAt @db.Timestamptz(5)

  @@map("reseller")
}

// Закупочный ключ компании (хранится только хеш; значение показывается один раз)
model ResellerApiKey {
  id           Int               @id @default(autoincrement())
  reseller_id  Int
  name         String?
  prefix       String            @unique
  key_hash     String
  status       ResellerKeyStatus @default(ACTIVE)
  last_used_at DateTime?         @db.Timestamptz(5)
  revoked_at   DateTime?         @db.Timestamptz(5)

  reseller Reseller @relation(fields: [reseller_id], references: [id])

  created_at DateTime @default(now()) @db.Timestamptz(5)

  @@index([reseller_id])
  @@map("reseller_api_key")
}

// Тариф, доступный компании, и её закупочная цена; price_version растёт при каждой смене цены
model ResellerTariff {
  id            Int     @id @default(autoincrement())
  reseller_id   Int
  tariff_id     Int
  price_kopecks BigInt
  price_version Int     @default(1)
  active        Boolean @default(true)

  reseller Reseller @relation(fields: [reseller_id], references: [id])
  tariff   Tariff   @relation(fields: [tariff_id], references: [id])

  created_at DateTime  @default(now()) @db.Timestamptz(5)
  updated_at DateTime? @updatedAt @db.Timestamptz(5)

  @@unique([reseller_id, tariff_id])
  @@map("reseller_tariff")
}

// Единственный достоверный денежный баланс компании.
// available = balance_kopecks - reserved_kopecks (CHECK в БД не даёт уйти в минус)
model ResellerAccount {
  reseller_id      Int    @id
  balance_kopecks  BigInt @default(0)
  reserved_kopecks BigInt @default(0)

  reseller Reseller @relation(fields: [reseller_id], references: [id])

  updated_at DateTime? @updatedAt @db.Timestamptz(5)

  @@map("reseller_account")
}

// Неизменяемый журнал: UPDATE/DELETE запрещены триггером; исправления — новыми проводками
model ResellerLedger {
  id                     Int                @id @default(autoincrement())
  reseller_id            Int
  type                   ResellerLedgerType
  delta_balance_kopecks  BigInt
  delta_reserved_kopecks BigInt
  balance_after          BigInt
  reserved_after         BigInt
  reseller_order_id      Int?
  comment                String?
  actor                  String?
  idempotency_key        String

  reseller Reseller       @relation(fields: [reseller_id], references: [id])
  order    ResellerOrder? @relation(fields: [reseller_order_id], references: [id])

  created_at DateTime @default(now()) @db.Timestamptz(5)

  @@unique([reseller_id, idempotency_key])
  @@index([reseller_id, id])
  @@index([reseller_order_id])
  @@map("reseller_ledger")
}

model ResellerOrder {
  id              Int                @id @default(autoincrement())
  reseller_id     Int
  client_order_id String
  request_hash    String
  state           ResellerOrderState @default(RESERVED)
  state_reason    String?

  tariff_id      Int
  tariff_name_ru String
  tariff_name_en String
  data_gb        Int?
  validity_days  Int?
  price_kopecks  BigInt
  price_version  Int
  currency       String @default("RUB")

  source     String?
  source_ref String?

  // Служебные данные поставщика — отдаются только управляющему API
  provider_response Json?

  submitting_at DateTime? @db.Timestamptz(5)
  submitted_at  DateTime? @db.Timestamptz(5)
  issued_at     DateTime? @db.Timestamptz(5)
  failed_at     DateTime? @db.Timestamptz(5)

  reseller Reseller         @relation(fields: [reseller_id], references: [id])
  tariff   Tariff           @relation(fields: [tariff_id], references: [id])
  sim      Sims?
  order    Order?
  ledger   ResellerLedger[]

  created_at DateTime  @default(now()) @db.Timestamptz(5)
  updated_at DateTime? @updatedAt @db.Timestamptz(5)

  @@unique([reseller_id, client_order_id])
  @@index([state])
  @@index([reseller_id, updated_at])
  @@map("reseller_order")
}
